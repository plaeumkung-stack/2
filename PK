-- ── Core Macro Functions ──────────────────────────────────────────────────────

-- 1. ฟังก์ชันสั่งวางยูนิตออโต้
local function autoPlaceUnit(slot, targetCFrame)
    pcall(function()
        -- ทริกเกอร์เลือกสล็อตยูนิต
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.One, false, game)
        task.wait(0.2)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.One, false, game)
        task.wait(0.3)
        
        -- ส่งรีโมทสั่งวางยูนิตตรงพิกัดใต้เท้าตัวละคร
        local inputRemote = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("Input")
        if inputRemote then
            local args = {
                [1] = "PlaceUnit",
                [2] = slot,
                [3] = targetCFrame
            }
            inputRemote:FireServer(unpack(args))
            print("[PK-MACRO] วางยูนิตสล็อต " .. slot .. " สำเร็จ!")
        end
    end)
end

-- 2. ฟังก์ชันอัปเกรดยูนิตทั้งหมดที่เราวางไว้
local function autoUpgradeAll()
    pcall(function()
        -- วนลูปหาโมเดลยูนิตที่เป็นของเราใน Workspace (ตัวเกมมักจะแปะชื่อเจ้าของไว้ที่ Attribute หรือ Object Name)
        local inputRemote = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("Input")
        if not inputRemote then return end

        -- สแกนหาพาร์ทชิ้นส่วนยูนิตที่อยู่ในด่านเพื่อส่งรีโมทอัปเกรดรัวๆ
        for _, obj in pairs(workspace:GetChildren()) do
            if obj:IsA("Model") and (obj:GetAttribute("Owner") == Player.Name or obj.Name:find(Player.Name)) then
                for i = 1, MacroConfig.UpgradeLoops do
                    local args = {
                        [1] = "UpgradeUnit",
                        [2] = obj
                    }
                    inputRemote:FireServer(unpack(args))
                    task.wait(0.1)
                end
            end
        end
    end)
end

-- 3. ลูปตรวจจับเกมจบเพื่อกดเริ่มด่านเดิมใหม่วนไป (Auto Replay Loop)
local function startReplayMonitor()
    task.spawn(function()
        while true do
            task.wait(2)
            if not MacroConfig.IsRunning then break end
            
            pcall(function()
                -- ตรวจเช็คว่า UI สรุปคะแนนหรือ FinishFrame โผล่ขึ้นมาหรือยัง
                local guiHUD = Player.PlayerGui:FindFirstChild("HUD")
                local finishFrame = guiHUD and (guiHUD:FindFirstChild("FinishedFrame") or guiHUD:FindFirstChild("WinFrame"))
                
                if finishFrame and finishFrame.Visible then
                    print("[PK-MACRO] จบด่านแล้ว! กำลังกด Replay เริ่มลูปใหม่ใน 3 วินาที...")
                    task.wait(3)
                    
                    local replayRemote = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("Replay")
                    if replayRemote then
                        replayRemote:FireServer()
                    end
                end
            end)
        end
    end)
end

-- ── ระบบจัดการลูปทำงานหลักแบบ One-Click ─────────────────────────────────────────
local function runMainMacroProcess()
    print("[PK-MACRO] เริ่มกระบวนการฟาร์มมาโครออโต้...")
    
    -- เปิดระบบมอนิเตอร์ปุ่มกดเริ่มเกมใหม่รอไว้เลย
    startReplayMonitor()
    
    while MacroConfig.IsRunning do
        pcall(function()
            local root = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
            if root then
                -- ขั้นตอนที่ 1: เดินไปจุดยุทธศาสตร์ย่อย หรือวางยูนิตตัวแรกใต้เท้าทันที
                autoPlaceUnit(MacroConfig.UnitSlot, root.CFrame * CFrame.new(0, -3, -4))
                task.wait(5)
                
                -- ขั้นตอนที่ 2: สั่งอัปเกรดรัวๆ ทุกตัวที่วางไว้กินตังค์ในเกม
                autoUpgradeAll()
            end
        end)
        task.wait(10) -- หน่วงเวลาเช็คลูปทุกๆ 10 วินาทีป้องกันสคริปต์หลุด
    end
end

