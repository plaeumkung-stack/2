local MacroConfig = {
    UnitSlot = 1,              -- ช่องยูนิตที่ต้องการวาง (ปุ่ม 1)
    UpgradeLoops = 5,          -- จำนวนรอบที่จะให้สั่งอัปเกรดรัวๆ
    IsRunning = false          -- สถานะเปิด/ปิดระบบ
