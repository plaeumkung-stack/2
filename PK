-- [[ PK-MODIFIED | ASTD AUTO-FARM MACRO HUB ]] --

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local VirtualInputManager = game:GetService("VirtualInputManager")

local Player = Players.LocalPlayer
local Character = Player.Character or Player.CharacterAdded:Wait()

-- CONFIGURATION (ปรับแต่งค่าตามทีมของมึงได้เลยโบร)
local UNIT_SLOT = 1          -- ช่องยูนิตที่ต้องการวาง (กดปุ่ม 1, 2, 3, 4...)
local PLACE_COORDINATE = CFrame.new(0, 0, 0) -- พิกัดที่จะให้ตัวละครเดินไปวาง (หรือเซ็ตพิกัดแมพ)

-- ── 1. ฟังก์ชันสั่งวางยูนิตอัตโนมัติ (Auto Place) ──────────────────────────────
local function autoPlaceUnit(slot, targetCFrame)
    pcall(function()
        -- จำลองการกดปุ่มเลือกช่องยูนิตบนคีย์บอร์ด
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode["Space"], false, game) -- ตัวอย่างเปลี่ยนสล็อต
        task.wait(0.2)
        
        -- เรียกใช้ Remote ของเกมตรงๆ เพื่อวางยูนิต (เร็วกว่าและไม่พลาด)
        -- หมายเหตุ: รีโมทของ ASTD อาจมีการเปลี่ยนชื่อในแต่ละอัปเดต ให้ระวังตรงนี้
        local args = {
            [1] = "PlaceUnit",
            [2] = slot,
            [3] = targetCFrame
        }
        ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Input"):FireServer(unpack(args))
        print("[PK-MACRO] วางยูนิตช่อง " .. slot .. " เรียบร้อย!")
    end)
end

-- ── 2. ฟังก์ชันสั่งอัปเกรดยูนิต (Auto Upgrade) ─────────────────────────────────
local function autoUpgradeUnit(unitModel)
    if not unitModel then return end
    pcall(function()
        local args = {
            [1] = "UpgradeUnit",
            [2] = unitModel
        }
        ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Input"):FireServer(unpack(args))
        print("[PK-MACRO] สั่งอัปเกรดยูนิตแล้วโบร!")
    end)
end

-- ── 3. ลูปเช็คเมื่อเกมจบเพื่อกดเริ่มใหม่ (Auto Replay Loop) ──────────────────────
local function startAutoReplay()
    task.spawn(function()
        while task.wait(2) do
            pcall(function()
                -- เช็ค UI ตอนจบเกม (ดึงจากหน้าต่างเงินรางวัล หรือปุ่ม Replay)
                local hud = Player.PlayerGui:FindFirstChild("HUD")
                if hud and hud:FindFirstChild("FinishedFrame") and hud.FinishedFrame.Visible then
                    print("[PK-MACRO] เกมจบแล้ว! กำลังกดเริ่มเกมใหม่ให้อัตโนมัติ...")
                    task.wait(1)
                    
                    -- ทริกเกอร์รีโมทรันด่านเดิมซ้ำ
                    local replayRemote = ReplicatedStorage:FindFirstChild("Remotes"):FindFirstChild("Replay")
                    if replayRemote then
                        replayRemote:FireServer()
                    end
                end
            end)
        end
    end)
end

-- ── 🚀 สั่งรันระบบมาโคร ────────────────────────────────────────────────────────
print("[PK ASTD MACRO] ระบบมาโครเริ่มทำงานแล้วไอ่สัส!")

-- เปิดใช้งานระบบออโต้รีเพลย์รอไว้เลย
startAutoReplay()

-- ตัวอย่าง: บอทสั่งวางยูนิตช่อง 1 ทันทีเมื่อเข้าเกม
task.wait(5)
autoPlaceUnit(UNIT_SLOT, Player.Character.HumanoidRootPart.CFrame * CFrame.new(0, -3, -5))
